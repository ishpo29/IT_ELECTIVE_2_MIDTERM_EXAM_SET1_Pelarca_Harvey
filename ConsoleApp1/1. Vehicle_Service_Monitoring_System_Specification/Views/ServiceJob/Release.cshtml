@model ServiceJobReleaseDto
@{
    ViewData["Title"] = "Release Vehicle";
}

<div class="confirm-shell">
    <div class="confirm-card">
        <div class="confirm-icon">🚗</div>
        <h2 style="font-weight:700; font-size:1.3rem;">Release Vehicle?</h2>
        <p class="text-body-secondary mb-0">Are you sure you want to mark this vehicle as released?</p>

        <dl class="row confirm-details">
            <dt class="col-6">Service Number</dt>
            <dd class="col-6 text-end text-service-number">@Model.ServiceNumber</dd>
            <dt class="col-6">Customer</dt>
            <dd class="col-6 text-end">@Model.CustomerName</dd>
            <dt class="col-6">Vehicle</dt>
            <dd class="col-6 text-end">@Model.VehicleMake @Model.VehicleModel</dd>
            <dt class="col-6">Plate Number</dt>
            <dd class="col-6 text-end">@Model.PlateNumber</dd>
            <dt class="col-6">Service Type</dt>
            <dd class="col-6 text-end">@Model.ServiceType</dd>
        </dl>

        <form asp-controller="ServiceJob" asp-action="ReleaseConfirmed" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            <a asp-controller="ServiceJob" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-50">Cancel</a>
            <button type="submit" class="btn btn-primary w-50">
                <i class="bi bi-check-lg"></i> Confirm Release
            </button>
        </form>
    </div>
</div>

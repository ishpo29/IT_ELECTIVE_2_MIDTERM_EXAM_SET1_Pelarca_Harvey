@model ServiceJobCreateDto
@{
    ViewData["Title"] = "Register Vehicle";
}

<div class="page-header mb-4">
    <h1>Register Vehicle</h1>
    <p>Check in a new customer vehicle for service.</p>
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>

<form asp-controller="ServiceJob" asp-action="Create" method="post">

    <div class="section-card mb-3">
        <div class="form-section-title"><i class="bi bi-person text-body-secondary"></i> Customer Information</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="CustomerName" class="form-label">Customer Name</label>
                <input asp-for="CustomerName" class="form-control" placeholder="e.g. Juan Dela Cruz" />
                <span asp-validation-for="CustomerName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ContactNumber" class="form-label">Contact Number</label>
                <input asp-for="ContactNumber" class="form-control" placeholder="e.g. 0917-123-4567" />
                <span asp-validation-for="ContactNumber" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="section-card mb-3">
        <div class="form-section-title"><i class="bi bi-car-front text-body-secondary"></i> Vehicle Information</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="VehicleMake" class="form-label">Vehicle Make</label>
                <input asp-for="VehicleMake" class="form-control" placeholder="e.g. Toyota" />
                <span asp-validation-for="VehicleMake" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="VehicleModel" class="form-label">Vehicle Model</label>
                <input asp-for="VehicleModel" class="form-control" placeholder="e.g. Vios" />
                <span asp-validation-for="VehicleModel" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ModelYear" class="form-label">Model Year</label>
                <input asp-for="ModelYear" class="form-control" placeholder="e.g. 2021" />
                <span asp-validation-for="ModelYear" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="PlateNumber" class="form-label">Plate Number</label>
                <input asp-for="PlateNumber" class="form-control" placeholder="e.g. ABC-1234" />
                <span asp-validation-for="PlateNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="VehicleColor" class="form-label">Vehicle Color</label>
                <input asp-for="VehicleColor" class="form-control" placeholder="e.g. White" />
                <span asp-validation-for="VehicleColor" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="section-card mb-3">
        <div class="form-section-title"><i class="bi bi-tools text-body-secondary"></i> Service Information</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Service Number</label>
                <input type="text" class="form-control" value="@ViewBag.NextServiceNumber" disabled />
            </div>
            <div class="col-md-6">
                <label asp-for="ServiceType" class="form-label">Service Type</label>
                <select asp-for="ServiceType" class="form-select">
                    <option value="">Select service type</option>
                    <option>Oil Change</option>
                    <option>Brake Repair</option>
                    <option>Tire Replacement</option>
                    <option>General Check-up</option>
                    <option>Engine Repair</option>
                    <option>Aircon Service</option>
                    <option>Battery Replacement</option>
                    <option>Other</option>
                </select>
                <span asp-validation-for="ServiceType" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ServiceBay" class="form-label">Service Bay</label>
                <select asp-for="ServiceBay" class="form-select">
                    <option value="">Select bay</option>
                    <option>Bay 1</option>
                    <option>Bay 2</option>
                    <option>Bay 3</option>
                    <option>Bay 4</option>
                </select>
                <span asp-validation-for="ServiceBay" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CheckInDateTime" class="form-label">Check-in Date &amp; Time</label>
                <input asp-for="CheckInDateTime" type="datetime-local" class="form-control" />
                <span asp-validation-for="CheckInDateTime" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ExpectedReleaseDate" class="form-label">Expected Release Date</label>
                <input asp-for="ExpectedReleaseDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="ExpectedReleaseDate" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="section-card mb-4">
        <div class="form-section-title"><i class="bi bi-card-text text-body-secondary"></i> Additional Information</div>
        <label asp-for="Remarks" class="form-label">Remarks</label>
        <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Optional notes about the service"></textarea>
        <span asp-validation-for="Remarks" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <a asp-controller="ServiceJob" asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-check-lg"></i> Register Vehicle
        </button>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

@model DetailsDto
@{
    ViewData["Title"] = "Service Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 style="font-size:1.4rem; font-weight:700; margin-bottom:0.35rem;">
            Service <span class="text-service-number">#@Model.ServiceNumber</span>
        </h1>
        @await Html.PartialAsync("_StatusBadge", Model.Status)
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="section-card h-100">
            <div class="form-section-title"><i class="bi bi-person text-body-secondary"></i> Customer Information</div>
            <dl class="row mb-0">
                <dt class="col-5 text-body-secondary fw-normal">Customer Name</dt>
                <dd class="col-7 fw-semibold">@Model.CustomerName</dd>
                <dt class="col-5 text-body-secondary fw-normal">Contact Number</dt>
                <dd class="col-7 fw-semibold">@Model.ContactNumber</dd>
            </dl>
        </div>
    </div>

    <div class="col-md-6">
        <div class="section-card h-100">
            <div class="form-section-title"><i class="bi bi-car-front text-body-secondary"></i> Vehicle Information</div>
            <dl class="row mb-0">
                <dt class="col-5 text-body-secondary fw-normal">Make</dt>
                <dd class="col-7 fw-semibold">@Model.VehicleMake</dd>
                <dt class="col-5 text-body-secondary fw-normal">Model</dt>
                <dd class="col-7 fw-semibold">@Model.VehicleModel</dd>
                <dt class="col-5 text-body-secondary fw-normal">Year</dt>
                <dd class="col-7 fw-semibold">@Model.ModelYear</dd>
                <dt class="col-5 text-body-secondary fw-normal">Plate Number</dt>
                <dd class="col-7 fw-semibold">@Model.PlateNumber</dd>
                <dt class="col-5 text-body-secondary fw-normal">Color</dt>
                <dd class="col-7 fw-semibold">@Model.VehicleColor</dd>
            </dl>
        </div>
    </div>

    <div class="col-md-6">
        <div class="section-card h-100">
            <div class="form-section-title"><i class="bi bi-tools text-body-secondary"></i> Service Information</div>
            <dl class="row mb-0">
                <dt class="col-5 text-body-secondary fw-normal">Service Type</dt>
                <dd class="col-7 fw-semibold">@Model.ServiceType</dd>
                <dt class="col-5 text-body-secondary fw-normal">Service Bay</dt>
                <dd class="col-7 fw-semibold">@Model.ServiceBay</dd>
                <dt class="col-5 text-body-secondary fw-normal">Check-in</dt>
                <dd class="col-7 fw-semibold">@Model.CheckInDateTime.ToString("MMM d, yyyy - h:mm tt")</dd>
                <dt class="col-5 text-body-secondary fw-normal">Expected Release</dt>
                <dd class="col-7 fw-semibold">@Model.ExpectedReleaseDate.ToString("MMM d, yyyy - h:mm tt")</dd>
                <dt class="col-5 text-body-secondary fw-normal">Actual Release</dt>
                <dd class="col-7 fw-semibold">@(Model.ActualReleaseDateTime?.ToString("MMM d, yyyy - h:mm tt") ?? "—")</dd>
            </dl>
        </div>
    </div>

    <div class="col-md-6">
        <div class="section-card h-100">
            <div class="form-section-title"><i class="bi bi-card-text text-body-secondary"></i> Remarks</div>
            <p class="mb-0" style="font-size:0.9rem;">
                @(string.IsNullOrWhiteSpace(Model.Remarks) ? "No remarks provided." : Model.Remarks)
            </p>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 mt-4">
    <a asp-controller="ServiceJob" asp-action="Index" class="btn btn-outline-secondary px-4">
        <i class="bi bi-arrow-left"></i> Back to Monitoring
    </a>
    <a asp-controller="ServiceJob" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
        <i class="bi bi-pencil"></i> Edit Service
    </a>
    @if (Model.Status != ServiceStatus.Released)
    {
        <a asp-controller="ServiceJob" asp-action="Release" asp-route-id="@Model.Id" class="btn btn-primary px-4">
            <i class="bi bi-box-arrow-right"></i> Release Vehicle
        </a>
    }
</div>

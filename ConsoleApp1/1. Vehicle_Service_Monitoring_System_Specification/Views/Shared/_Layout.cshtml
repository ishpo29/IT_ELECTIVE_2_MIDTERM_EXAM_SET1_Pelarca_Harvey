@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var firstName = User.Identity?.IsAuthenticated == true
        ? User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.GivenName)?.Value
        : null;
    var initials = string.IsNullOrEmpty(firstName) ? "U" : firstName.Substring(0, 1).ToUpper();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AutoCare</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="app-shell">

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <aside class="ac-sidebar" id="acSidebar">
            <div class="brand">
                <div class="brand-title"><i class="bi bi-car-front-fill"></i> AUTOCARE</div>
                <div class="brand-subtitle">Vehicle Service Center</div>
            </div>

            <nav class="nav-section">
                <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a class="nav-link @(currentController == "ServiceJob" ? "active" : "")" asp-controller="ServiceJob" asp-action="Index">
                    <i class="bi bi-car-front"></i> Service Monitoring
                </a>
                <a class="nav-link @(currentController == "ServiceJob" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" asp-controller="ServiceJob" asp-action="Create">
                    <i class="bi bi-plus-circle"></i> Register Vehicle
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="user-mini">
                    <div class="user-avatar">@initials</div>
                    <div>
                        <div class="user-name">@(firstName ?? "User")</div>
                        <div class="user-role">Service Advisor</div>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="logout-btn">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </aside>

        <div class="ac-main">
            <header class="ac-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="sidebar-toggle-btn" id="sidebarToggleBtn" type="button">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <p class="page-title">@ViewData["Title"]</p>
                        @if (ViewData["Breadcrumb"] != null)
                        {
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    @Html.Raw(ViewData["Breadcrumb"])
                                </ol>
                            </nav>
                        }
                    </div>
                </div>
                <div class="topbar-actions">
                    <button class="icon-btn" type="button" title="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="badge-dot"></span>
                    </button>
                    <div class="user-chip">
                        <div class="user-avatar">@initials</div>
                        <span class="d-none d-sm-inline fw-semibold" style="font-size:0.88rem;">@(firstName ?? "User")</span>
                    </div>
                </div>
            </header>

            <main class="ac-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-check-circle-fill"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-info-circle-fill"></i>
                        <div>@TempData["InfoMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sidebar = document.getElementById('acSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        const toggleBtn = document.getElementById('sidebarToggleBtn');

        function closeSidebar() {
            sidebar.classList.remove('show');
            backdrop.classList.remove('show');
        }

        toggleBtn?.addEventListener('click', () => {
            sidebar.classList.toggle('show');
            backdrop.classList.toggle('show');
        });

        backdrop?.addEventListener('click', closeSidebar);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

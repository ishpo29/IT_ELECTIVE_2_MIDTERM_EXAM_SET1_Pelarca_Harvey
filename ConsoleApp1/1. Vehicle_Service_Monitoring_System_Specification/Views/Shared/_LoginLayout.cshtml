<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AutoCare</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="auth-shell">
        <div class="auth-visual">
            <div class="auth-icon-badge"><i class="bi bi-car-front-fill"></i></div>
            <div class="auth-brand">AUTOCARE</div>
            <div class="auth-subtitle">Vehicle Service Monitoring System</div>
            <div class="auth-desc">Manage vehicle service operations from check-in to release.</div>
        </div>
        <div class="auth-form-side">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
